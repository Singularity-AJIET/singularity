# ─────────────────────────────────────────────────────────────────────────────
# Singularity '26 — Backend Environment Configuration
# Copy this file to `.env` and fill in your values before starting the server.
# Never commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Server ──────────────────────────────────────────────────────────────────

# Port the Express server will listen on
PORT=3001

# Public-facing base URL of the API (used for QR code links in emails and logs)
# In production: https://api.singularity26.com
API_URL=http://localhost:3001

# Public-facing URL of the frontend (used for CORS whitelisting in production)
# In production: https://singularity26.com
FRONTEND_URL=http://localhost:3000


# ─── Database (Turso / LibSQL) ────────────────────────────────────────────────
# For local development, use a file:// URL (SQLite):
#   DATABASE_URL="file:./prisma/dev.db"
#
# For production, use your Turso database URL:
#   TURSO_DATABASE_URL="libsql://your-db-name-orgname.turso.io"
#
# The app checks TURSO_DATABASE_URL first, then falls back to DATABASE_URL.

TURSO_DATABASE_URL="libsql://your-db-name.turso.io"

# Auth token for Turso cloud database (leave blank for local file:// SQLite)
TURSO_AUTH_TOKEN=


# ─── Security / JWT ───────────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens for admin authentication.
# Must be a long, random, unpredictable string (64+ characters recommended).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Used by:  EVENT_SIGNING_KEY → also signs participant QR tokens
#           JWT_SECRET        → admin login tokens (falls back to EVENT_SIGNING_KEY)

EVENT_SIGNING_KEY=your-64-char-hex-secret-key-here

# Optional override for admin JWT secret (defaults to EVENT_SIGNING_KEY if not set)
# JWT_SECRET=


# ─── Participant QR Pass Token Expiry ─────────────────────────────────────────
# How long a participant's emailed QR pass token is valid (in seconds).
# Default: 604800 = 7 days
TOKEN_EXPIRY_SECONDS=604800


# ─── Email (Brevo SMTP) ───────────────────────────────────────────────────────
# Used to send QR access passes to participants after check-in.
# Sign up at https://www.brevo.com — free tier allows 300 emails/day.

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587

# Your Brevo SMTP login (usually your account email)
SMTP_USER=your-brevo-login@example.com

# Your Brevo SMTP password / API key (found in Brevo → SMTP & API → SMTP)
SMTP_PASS=your-brevo-smtp-password

# The "From" email address shown to recipients
SMTP_FROM="noreply@yourevent.com"

# The "From" display name shown to recipients
SMTP_FROM_NAME="Singularity '26"
