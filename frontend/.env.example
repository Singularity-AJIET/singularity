# ─────────────────────────────────────────────────────────────────────────────
# Singularity '26 — Frontend Environment Configuration
# Copy this file to `.env.local` and fill in your values before starting.
# Never commit your actual .env.local file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend API ──────────────────────────────────────────────────────────────
# The publicly accessible URL of the Singularity backend API.
# This MUST start with NEXT_PUBLIC_ so it is available in the browser bundle.
#
# Local development (leave unset — auto-resolves to current hostname:3001):
#   (comment out or delete this line)
#
# Production example:
#   NEXT_PUBLIC_API_URL=https://api.singularity26.com
#
# NEXT_PUBLIC_API_URL=http://localhost:3001
